# Copie para .env e ajuste se alguma porta já estiver em uso. Todos os valores têm default no compose.

# Postgres (superusuário, só para administração)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
# Senha dos usuários de cada serviço (catalog, orders, inventory, payments, notifications)
SERVICE_DB_PASSWORD=compra-facil

REDIS_PORT=6379

# Kafka (Redpanda) acessado do host
KAFKA_PORT=19092
SCHEMA_REGISTRY_PORT=18081
REDPANDA_CONSOLE_PORT=8080

# Mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
