# Copie para .env e ajuste se alguma porta já estiver em uso. Todos os valores têm default no compose.

# Postgres (superusuário, só para administração)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
# Senha dos usuários de cada serviço (catalog, orders, inventory, payments, notifications)
SERVICE_DB_PASSWORD=compra-facil

REDIS_PORT=6379

# Gateway (Traefik): única entrada externa. Dashboard só em 127.0.0.1.
GATEWAY_PORT=80
TRAEFIK_DASHBOARD_PORT=8090
# Origens do front liberadas no CORS (separadas por vírgula; ex.: inclua o domínio do deploy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Kafka (Redpanda) acessado do host
KAFKA_PORT=19092
SCHEMA_REGISTRY_PORT=18081
REDPANDA_CONSOLE_PORT=8080

# Observabilidade (só em 127.0.0.1): Grafana (3001 para deixar a 3000 ao front), Prometheus, OTLP
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
