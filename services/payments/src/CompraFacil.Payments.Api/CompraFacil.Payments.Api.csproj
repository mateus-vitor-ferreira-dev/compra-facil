<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Cobrança dos pedidos. -->
  <ItemGroup>
    <ProjectReference Include="../CompraFacil.Payments.Application/CompraFacil.Payments.Application.csproj" />
    <ProjectReference Include="../CompraFacil.Payments.Infrastructure/CompraFacil.Payments.Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)libs/dotnet/CompraFacil.BuildingBlocks/CompraFacil.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- o contrato (fonte da verdade) vai junto do binário e é servido em /openapi e /docs -->
    <Content Include="$(RepoRoot)contracts/openapi/payments.v1.yaml" Link="openapi/payments.v1.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)contracts/openapi/common/v1/common.yaml" Link="openapi/common/v1/common.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
