<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Saldo e reservas de estoque. -->
  <ItemGroup>
    <!-- ferramentas do EF (dotnet ef migrations) usam a Api como projeto de startup -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CompraFacil.Inventory.Application/CompraFacil.Inventory.Application.csproj" />
    <ProjectReference Include="../CompraFacil.Inventory.Infrastructure/CompraFacil.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)libs/dotnet/CompraFacil.BuildingBlocks/CompraFacil.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- o contrato (fonte da verdade) vai junto do binário e é servido em /openapi e /docs -->
    <Content Include="$(RepoRoot)contracts/openapi/inventory.v1.yaml" Link="openapi/inventory.v1.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)contracts/openapi/common/v1/common.yaml" Link="openapi/common/v1/common.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)contracts/openapi/common/v1/dead-letters.yaml" Link="openapi/common/v1/dead-letters.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
