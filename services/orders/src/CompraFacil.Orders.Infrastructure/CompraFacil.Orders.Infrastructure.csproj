<Project Sdk="Microsoft.NET.Sdk">
  <!-- EF Core + Npgsql (banco orders), cliente gRPC do catalog (com Polly) e mensageria. -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Polly.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- cliente gerado do contrato gRPC do catalog (o servidor Go gera o dele com o Buf). A base do
         servidor também é gerada (Both) para o catalog falso dos testes de integração: gerar de novo
         no projeto de testes duplicaria os tipos. -->
    <Protobuf Include="$(RepoRoot)contracts/proto/catalog/v1/catalog.proto" ProtoRoot="$(RepoRoot)contracts/proto" GrpcServices="Both" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CompraFacil.Orders.Application/CompraFacil.Orders.Application.csproj" />
    <ProjectReference Include="$(RepoRoot)libs/dotnet/CompraFacil.BuildingBlocks/CompraFacil.BuildingBlocks.csproj" />
  </ItemGroup>
</Project>
