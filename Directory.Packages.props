<!-- Versões de pacotes NuGet de todos os projetos .NET (Central Package Management).
     Os .csproj referenciam só o nome: <PackageReference Include="..." />. -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- versões abaixo também valem para dependências transitivas (correções de segurança) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Dados">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Autenticação">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Mensageria e observabilidade">
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Label="gRPC">
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>
  <ItemGroup Label="Resiliência">
    <!-- timeout, retry com jitter e circuit breaker na chamada gRPC do orders ao catalog (#81) -->
    <PackageVersion Include="Polly.Extensions" Version="8.8.0" />
  </ItemGroup>
  <ItemGroup Label="E-mail">
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="Fluid.Core" Version="2.40.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
  </ItemGroup>
  <ItemGroup Label="Segurança (transitivas)">
    <!-- via MimeKit (MailKit): 10.0.0–10.0.12 têm CVE-2026-84008 (GHSA-846f-f764-76mx) e GHSA-2fmv-rv2c-59x7.
         10.0.13 é a correção (2026-10-13); exceção à regra de versões com 2+ semanas por ser patch de segurança. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Aplicação">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redpanda" Version="4.15.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Yaml2JsonNode" Version="3.0.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
  </ItemGroup>
</Project>
