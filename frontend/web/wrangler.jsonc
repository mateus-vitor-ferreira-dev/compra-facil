{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A loja no Cloudflare Workers, pelo OpenNext (ADR 0006). O CI publica com `npm run deploy`; a conta
  // vem de CLOUDFLARE_ACCOUNT_ID, e o domínio da loja é um Custom Domain do Worker (README).
  "name": "compra-facil-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // O domínio da loja é o embrulhado.com.br (o nome novo, #407; zona no Cloudflare). Os dois subdomínios da
  // Digital Codexa continuam respondendo: são os endereços da entrega da disciplina e de links antigos.
  "routes": [
    { "pattern": "embrulhado.com.br", "custom_domain": true },
    { "pattern": "www.embrulhado.com.br", "custom_domain": true },
    { "pattern": "compra-facil.digitalcodexa.com", "custom_domain": true },
    { "pattern": "comprafacil.digitalcodexa.com", "custom_domain": true },
  ],
  // Valores do servidor que não são segredo. Os segredos (BFF_GATEWAY_KEY, GOOGLE_CLIENT_SECRET) vão
  // com `wrangler secret put`.
  "vars": {
    "API_URL": "https://compra-facil-api.49.12.249.23.sslip.io",
    "SITE_URL": "https://embrulhado.com.br",
    // o IP de quem compra, que a Cloudflare põe em toda requisição e não deixa o cliente forjar: o BFF
    // o repassa ao gateway para o rate limit ser por comprador (#176)
    "CLIENT_IP_HEADER": "cf-connecting-ip",
    // a loja de demonstração: a Efí simulada (o payment-sim), em sslip.io como a API (abre nas redes que
    // bloqueiam a zona). Na venda de verdade: "production" e o identificador de conta da Efí (#379)
    "PAYMENT_PROVIDER": "simulator",
    "PAYMENT_PROVIDER_URL": "https://compra-facil-pagamento.49.12.249.23.sslip.io",
    "DEMO_MODE": "true",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // a manutenção (#370): a marca do deploy, que o deploy.yml liga pela API do Cloudflare, e a janela agendada
  // pelo painel. O namespace compra-facil-manutencao da conta (deploy/README.md, "Aviso de manutenção"); o
  // wrangler dev usa uma cópia local, e o mesmo id vai na variável CLOUDFLARE_KV_MAINTENANCE_ID do repositório
  "kv_namespaces": [
    {
      "binding": "MAINTENANCE",
      "id": "5aa63329c6cf44af9434ac57fdc019ce",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "compra-facil-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
