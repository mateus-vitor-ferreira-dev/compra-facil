# versões exatas: o package-lock e o package.json dizem a mesma coisa
save-exact=true
engine-strict=true
# os peers opcionais do Vitest formam um ciclo (@vitest/browser-* pede vitest@*) que derruba o
# resolvedor do npm 10 e 11; os peers que o projeto usa (vite, jsdom) estão declarados no package.json
legacy-peer-deps=true
