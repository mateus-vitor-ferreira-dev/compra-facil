# Os segredos da produção. Copie para FORA do repositório (ex.: ~/.compra-facil/segredos.env), preencha e
# rode scripts/deploy/selar-segredos.sh com ele. Nunca faça commit do arquivo preenchido.

# o mesmo valor no gateway (Secret bff-gateway-key) e na Vercel (BFF_GATEWAY_KEY): openssl rand -hex 32
BFF_GATEWAY_KEY=

# a senha de cada serviço no Postgres, uma diferente por serviço: openssl rand -hex 24
PG_CATALOG_PASSWORD=
PG_ORDERS_PASSWORD=
PG_INVENTORY_PASSWORD=
PG_PAYMENTS_PASSWORD=
PG_NOTIFICATIONS_PASSWORD=
PG_IDENTITY_PASSWORD=

# a chave S3 do Object Storage, para os backups do Postgres (no infra/oci:
# tofu output s3_access_key_id; tofu output -raw s3_secret_access_key) e a região da conta
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OCI_REGION=sa-saopaulo-1

# só se os pacotes do GHCR forem privados: um token (classic) com read:packages
GHCR_USER=
GHCR_TOKEN=
