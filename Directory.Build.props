<!-- Vale para todos os projetos .NET do repositório (serviços e libs/dotnet). -->
<Project>
  <PropertyGroup>
    <!-- raiz do repositório, para os projetos linkarem os contratos (contracts/) -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- qualidade: aviso vira erro, análise recomendada e estilo do .editorconfig no build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: comentário XML obrigatório em todo membro público; aqui só onde explica algo -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- testes: nomes no padrão Metodo_Cenario_Resultado -->
    <NoWarn Condition="$(MSBuildProjectName.EndsWith('Tests')) Or $(MSBuildProjectName.EndsWith('Testing'))">$(NoWarn);CA1707</NoWarn>

    <!-- restore reproduzível: packages.lock.json versionado, CI restaura em modo travado -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
