{
  "uid": "compra-facil-campanha",
  "title": "CompraFácil — Campanha (catálogo)",
  "description": "O pico de leitura das campanhas: RPS e p95 do catálogo, rate limit do gateway, cache e réplicas (critérios do parecer).",
  "tags": [
    "compra-facil"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
