<Project Sdk="Microsoft.NET.Sdk">
  <!-- Casos de uso do notifications: orquestram o domínio e validam a entrada (FluentValidation). -->
  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Fluid.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Embrulhado.Notifications.Domain/Embrulhado.Notifications.Domain.csproj" />
    <!-- IHandleEvent e EventContext -->
    <ProjectReference Include="$(RepoRoot)libs/dotnet/Embrulhado.BuildingBlocks/Embrulhado.BuildingBlocks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Embrulhado.Notifications.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- templates dos e-mails (Liquid), embutidos no assembly -->
    <EmbeddedResource Include="Templates/*.liquid" />
  </ItemGroup>
</Project>
