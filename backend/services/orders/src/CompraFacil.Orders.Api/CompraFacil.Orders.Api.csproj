<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Pedidos e início/fim da SAGA de compra. -->
  <ItemGroup>
    <!-- ferramentas do EF (dotnet ef migrations) usam a Api como projeto de startup -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CompraFacil.Orders.Application/CompraFacil.Orders.Application.csproj" />
    <ProjectReference Include="../CompraFacil.Orders.Infrastructure/CompraFacil.Orders.Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)libs/dotnet/CompraFacil.BuildingBlocks/CompraFacil.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- o contrato (fonte da verdade) vai junto do binário e é servido em /openapi e /docs -->
    <Content Include="$(ContractsDir)openapi/orders.v1.yaml" Link="openapi/orders.v1.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(ContractsDir)openapi/common/v1/common.yaml" Link="openapi/common/v1/common.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(ContractsDir)openapi/common/v1/dead-letters.yaml" Link="openapi/common/v1/dead-letters.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
