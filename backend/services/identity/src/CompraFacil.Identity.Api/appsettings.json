{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=55432;Database=identity;Username=identity;Password=compra-facil"
  },
  "Database": {
    "MigrateOnStart": true
  },
  "Identity": {
    "Tokens": {
      "Issuer": "compra-facil-identity",
      "Audience": "compra-facil",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "30.00:00:00",
      "KeyRotateEvery": "30.00:00:00",
      "KeyPublishAhead": "1.00:00:00"
    },
    "EmailConfirmation": {
      "Required": false,
      "UrlTemplate": "http://localhost:3000/conta/confirmar-email?conta={account_id}&token={token}",
      "TokenLifetime": "1.00:00:00"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092"
  }
}
